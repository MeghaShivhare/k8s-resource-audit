{
  "apiVersion": "apps/v1",
  "kind": "DeploymentList",
  "items": [
    {
      "metadata": {
        "namespace": "backend",
        "name": "api"
      },
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "api",
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                }
              },
              {
                "name": "sidecar",
                "resources": {}
              }
            ]
          }
        }
      }
    },
    {
      "metadata": {
        "namespace": "backend",
        "name": "worker"
      },
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "worker",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "200m"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "metadata": {
        "namespace": "payments",
        "name": "checkout"
      },
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "checkout",
                "resources": {
                  "limits": {
                    "cpu": "1000m",
                    "memory": "1Gi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "metadata": {
        "namespace": "monitoring",
        "name": "exporter"
      },
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "name": "exporter",
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
